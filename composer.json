{
    "name": "danilovl/object-dto-mapper",
    "type": "symfony-bundle",
    "description": "Mapper that converts an object to a DTO.",
    "keywords": ["php","symfony","dto", "object mapper"],
    "license": "MIT",
    "authors": [
        {
            "name": "Vladimir Danilov"
        }
    ],
    "autoload": {
        "psr-4": {
            "Danilovl\\ObjectDtoMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Danilovl\\ObjectDtoMapper\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "psr/container": "^1.1 || ^2.0",
        "symfony/property-access": "^8.0",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "suggest": {
        "symfony/serializer": "Required to filter DTO properties by #[Groups] (allowGroups/ignoreGroups)"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.6",
        "symfony/serializer": "^8.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-symfony": "^2.0.9",
        "friendsofphp/php-cs-fixer": "^3.92.5",
        "symfony/framework-bundle": "^8.0"
    },
    "scripts": {
        "tests": "vendor/bin/phpunit tests/Unit tests/Functional",
        "phpstan": "phpstan analyse -c phpstan.neon src tests --no-progress",
        "phpstan-generate-baseline": "@php vendor/bin/phpstan analyse --level 9  --configuration phpstan.neon  src/ tests/ --generate-baseline",
        "cs-fixer": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "cs-fixer-check": "vendor/bin/php-cs-fixer fix --dry-run --allow-risky=yes"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
